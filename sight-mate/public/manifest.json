{
  "manifest_version": 3,
  "name": "SightMate",
  "version": "1.0",
  "description": "AI-powered accessibility checker.",
  "action": {
    "default_title": "Click to open SightMate"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["sidePanel", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"], 
  "web_accessible_resources": [
    {
      "resources": ["axe.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}